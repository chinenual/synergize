<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="synergize"
        Arguments=""
        InstallLocation="C:\Program Files\Chinenual\Synergize">
    </Installer>
    <PackageInformation
        PackageName="Synergize"
        PackageDisplayName="Synergize"
        PublisherName="CN=Chinenual"
        PublisherDisplayName="Steve Tynor (Chinenual)"
        Version="3.0.0-alpha1"
        PackageDescription="A portable voice editor/librarian for the DK Synergy">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.chinenual.synergize"
                Description="A portable voice editor/librarian for the DK SynergyA synergize application"
                DisplayName="Synergize"
                ExecutableName="Synergize"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>My Product</DisplayName>
            <PublisherDisplayName>Chinenual</PublisherDisplayName>
            <Description>A synergize application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="synergize.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
